<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDEAF0">

    <!-- 第 1 层：3D 小猪 -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 第 2 层：她的气泡，往上提，给猪留出脸 -->
    <TextView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bubble_bg"
        android:elevation="3dp"
        android:maxWidth="280dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:textColor="#463A3E"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 第 3 层：底部输入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="42dp"
        android:elevation="2dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="@string/hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#4A3F43"
            android:textColorHint="#C0A5AE"
            android:textSize="15sp" />

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/button_bg"
            android:backgroundTint="#EE93AB"
            android:minWidth="76dp"
            android:text="@string/send"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 第 4 层：菜单展开时的遮罩，点一下就收 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A000000"
        android:visibility="gone" />

    <!-- 第 5 层：顶部栏（标题 + 一个菜单按钮） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:elevation="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/input_bg"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="@string/menu"
            android:textColor="#8C6A75"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#6D4B57"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第 6 层：左上角按列展开的菜单 -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="62dp"
        android:background="@drawable/menu_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mi_record"
            style="@style/MenuItem"
            android:text="@string/record" />

        <TextView
            android:id="@+id/mi_learn"
            style="@style/MenuItem"
            android:text="@string/learn" />

        <TextView
            android:id="@+id/mi_name"
            style="@style/MenuItem"
            android:text="@string/menu_name" />

        <TextView
            android:id="@+id/mi_ai"
            style="@style/MenuItem"
            android:text="@string/menu_ai" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="4dp"
            android:background="#F0DCE3" />

        <TextView
            android:id="@+id/mi_close"
            style="@style/MenuItem"
            android:text="@string/menu_close" />
    </LinearLayout>
</FrameLayout>